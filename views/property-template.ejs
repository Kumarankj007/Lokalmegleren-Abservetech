function isEmptyHTML(s) {
  if (!s) return true;

  const stripped = s
    .replace(/&nbsp;|&#160;|&#xA0;/gi, '')
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, '')
    .trim();
  return stripped === '' ||
    s === '<div></div>' ||
    s === '<div><br /></div>' ||
    s === '<div><br />\r\n</div>' ||
    s.toLowerCase() === 'no data';
}

