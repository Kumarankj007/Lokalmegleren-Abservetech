const pagesBeforeOm = 3 + (sortedImages.length > 0 ? sortedImages.length * 2 : 0) + 1;

const omFirstContentPageNo = pagesBeforeOm + 3;

const omSectionPages =
  omEiendommenPages.length > 0 ? 1 + omEiendommenPages.length : 0;

const accordionFirstPageNo =
  pagesBeforeOm + omSectionPages + 1 + (showMegler2 ? 0 : 0) + 1;
