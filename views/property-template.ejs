  + 1;

const needsPadPage = totalPages % 2 === 1;

let _pn = 0;
function incPn() { _pn++; }
function pn() {
  _pn++;
  return '<div class="page-num-bar">'
    + '<img class="page-num-line" data-locked="true" src="data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\'/%3E" alt="" />'
    + '<div class="page-num" data-field="page-num">' + _pn + '</div>'
    + '</div>';
}

function omPill(pageNo) {

